# Supabase project dedicated to CHS Dispatch (not the Heartbeat project).
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Only used by `npm run seed:demo` on your machine. Never prefix with VITE_.
SUPABASE_SERVICE_ROLE_KEY=
DEMO_PASSWORD=

# Optional. Google Maps JavaScript API + Places API (New), browser key restricted to your site.
VITE_GOOGLE_MAPS_API_KEY=
# Optional. Map ID for advanced markers (DEMO_MAP_ID is used if blank; fine for testing).
VITE_GOOGLE_MAPS_MAP_ID=
# Optional. what3words API key, restricted to your site.
VITE_WHAT3WORDS_API_KEY=
